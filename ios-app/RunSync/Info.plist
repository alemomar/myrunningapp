<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>myrunningapp</string>
			</array>
		</dict>
	</array>
	<!-- RunSync n'utilise que du HTTPS standard (URLSession vers Supabase),
	     aucun chiffrement fait maison -> exempté de la conformité export.
	     Évite qu'App Store Connect repose la question à chaque build. -->
	<!-- Écran de lancement : le fond sombre de l'app (#0C0D0F), pas un écran blanc avant la page. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>FondApp</string>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
