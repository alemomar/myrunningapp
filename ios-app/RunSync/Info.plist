<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>myrunningapp</string>
			</array>
		</dict>
	</array>
	<!-- RunSync n'utilise que du HTTPS standard (URLSession vers Supabase),
	     aucun chiffrement fait maison -> exempté de la conformité export.
	     Évite qu'App Store Connect repose la question à chaque build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
